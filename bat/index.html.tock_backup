<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="theme-color" content="#07070e" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="description" content="AnimeTock — The ultimate anime short-video app." />
    <title>AnimeTock App</title>
    <link rel="manifest" href="./manifest.json" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@600;700;800&display=swap" rel="stylesheet" />
    <style>
      :root {
        color-scheme: dark;
        --bg: #07070e;
        --app-bg: #000000;
        --sheet-bg: #11101e;
        --border-glass: rgba(255, 255, 255, 0.1);
        --white: #ffffff;
        --pink: #ff2a85;
        --pink-glow: rgba(255, 42, 133, 0.45);
        --cyan: #00f0ff;
        --cyan-glow: rgba(0, 240, 255, 0.45);
        --purple: #9d4edd;
        --muted: #a19fb5;
        --muted-dim: #67657b;
        --font-main: "Plus Jakarta Sans", ui-sans-serif, system-ui, -apple-system, sans-serif;
        --font-display: "Space Grotesk", var(--font-main);
        --app-width: 412px;
        --app-height: 860px;
        --trans: 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
        --spring: 0.38s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        -webkit-tap-highlight-color: transparent;
        user-select: none;
      }

      html, body {
        height: 100%;
        width: 100%;
        overflow: hidden;
      }

      body {
        font-family: var(--font-main);
        color: var(--white);
        background: radial-gradient(circle at 50% 30%, rgba(157, 78, 221, 0.12), transparent 60%), #07070e;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      button {
        color: inherit;
        font: inherit;
        background: transparent;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: var(--trans);
      }

      svg {
        display: block;
        width: 100%;
        height: 100%;
        flex-shrink: 0;
      }

      /* Desktop Controls (Toggle Frame Mode & Theme) */
      .desktop-bar {
        position: fixed;
        top: 14px;
        right: 18px;
        display: flex;
        align-items: center;
        gap: 10px;
        z-index: 100;
      }

      .desk-btn {
        padding: 8px 14px;
        border-radius: 9999px;
        background: rgba(18, 17, 32, 0.85);
        border: 1px solid var(--border-glass);
        backdrop-filter: blur(16px);
        font-size: 11px;
        font-weight: 700;
        color: #fff;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
      }

      .desk-btn:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: var(--pink);
      }

      /* Smartphone Chassis Frame */
      .device-container {
        position: relative;
        width: var(--app-width);
        height: min(var(--app-height), calc(100dvh - 30px));
        border-radius: 46px;
        background: var(--app-bg);
        border: 4px solid #201e30;
        box-shadow:
          0 0 0 2px #0c0a15,
          0 25px 80px rgba(0, 0, 0, 0.85),
          0 0 60px rgba(157, 78, 221, 0.15);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: var(--trans);
      }

      /* Fullscreen Borderless Mode */
      body.mode-fullscreen .device-container,
      @media (max-width: 600px), (display-mode: standalone) {
        .device-container {
          width: 100vw !important;
          height: 100dvh !important;
          max-height: 100dvh !important;
          border-radius: 0 !important;
          border: none !important;
          box-shadow: none !important;
        }
        .desktop-bar {
          display: none;
        }
      }

      /* Device Status Bar (Clock, Island, Battery) */
      .status-bar {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 44px;
        padding: 0 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        z-index: 50;
        pointer-events: none;
        font-size: 13px;
        font-weight: 800;
        color: #fff;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
      }

      .status-time {
        font-family: var(--font-display);
        letter-spacing: -0.2px;
      }

      .dynamic-island {
        width: 90px;
        height: 24px;
        border-radius: 9999px;
        background: #000;
        box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08);
      }

      .status-icons {
        display: flex;
        align-items: center;
        gap: 6px;
        width: 54px;
        justify-content: flex-end;
      }

      .status-icon-svg {
        width: 16px;
        height: 16px;
      }

      /* Native App Header Bar */
      .app-header {
        position: absolute;
        top: 44px;
        left: 0;
        right: 0;
        height: 48px;
        padding: 0 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        z-index: 40;
      }

      .app-header-title {
        font-family: var(--font-display);
        font-size: 16px;
        font-weight: 800;
        letter-spacing: -0.5px;
        opacity: 0.9;
      }

      .app-header-title span {
        color: var(--pink);
      }

      .app-tabs {
        display: flex;
        align-items: center;
        gap: 20px;
      }

      .app-tab {
        font-size: 15px;
        font-weight: 800;
        color: var(--muted);
        position: relative;
        padding: 6px 0;
      }

      .app-tab.active {
        color: #fff;
        text-shadow: 0 0 12px rgba(255, 255, 255, 0.5);
      }

      .app-tab.active::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 28px;
        height: 3px;
        border-radius: 9999px;
        background: var(--pink);
        box-shadow: 0 0 10px var(--pink);
      }

      .header-right-actions {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .sound-pill {
        display: flex;
        align-items: center;
        gap: 4px;
        height: 32px;
        padding: 0 10px;
        border-radius: 9999px;
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid var(--border-glass);
        backdrop-filter: blur(12px);
        color: var(--cyan);
        cursor: pointer;
        transition: var(--trans);
      }

      .sound-pill:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: var(--cyan);
      }

      .sound-pill.muted {
        color: var(--muted-dim);
      }

      .sound-pill .eq-bars {
        display: flex;
        align-items: flex-end;
        gap: 2px;
        height: 12px;
      }

      .sound-pill .eq-bar {
        width: 2.5px;
        background: currentColor;
        border-radius: 1px;
        animation: eqPulse 0.75s ease-in-out infinite alternate;
      }

      .sound-pill .eq-bar:nth-child(1) { height: 40%; animation-delay: 0.1s; }
      .sound-pill .eq-bar:nth-child(2) { height: 100%; animation-delay: 0.3s; }
      .sound-pill .eq-bar:nth-child(3) { height: 65%; animation-delay: 0.2s; }

      .sound-pill.muted .eq-bar {
        height: 2px !important;
        animation: none !important;
      }

      @keyframes eqPulse {
        0% { height: 25%; }
        100% { height: 100%; }
      }

      .sound-hint-pill {
        position: absolute;
        top: 96px;
        left: 50%;
        transform: translateX(-50%);
        padding: 6px 14px;
        border-radius: 9999px;
        background: rgba(18, 17, 32, 0.9);
        border: 1px solid var(--cyan);
        box-shadow: 0 4px 18px var(--cyan-glow);
        font-size: 11px;
        font-weight: 700;
        color: #fff;
        z-index: 45;
        cursor: pointer;
        animation: pulseHint 2s infinite alternate;
        transition: opacity 0.3s;
      }

      @keyframes pulseHint {
        0% { transform: translateX(-50%) scale(1); }
        100% { transform: translateX(-50%) scale(1.05); }
      }

      .header-action-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid var(--border-glass);
        backdrop-filter: blur(10px);
        color: #fff;
        padding: 7px;
      }

      .header-action-btn:hover {
        background: rgba(255, 255, 255, 0.15);
      }

      /* Feed Scroller Viewport */
      .app-feed {
        position: relative;
        width: 100%;
        height: 100%;
        overflow-y: auto;
        overscroll-behavior-y: contain;
        scroll-snap-type: y mandatory;
        scrollbar-width: none;
      }

      .app-feed::-webkit-scrollbar { display: none; }

      /* App Reel Item */
      .app-reel {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 100%;
        scroll-snap-align: start;
        scroll-snap-stop: always;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        isolation: isolate;
      }

      .app-reel[hidden] {
        display: none !important;
      }

      /* Scene & Canvas Background */
      .scene {
        position: absolute;
        inset: 0;
        overflow: hidden;
        z-index: 1;
      }

      .scene-bg {
        position: absolute;
        inset: -10%;
        width: 120%;
        height: 120%;
      }

      .scene-particles {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 2;
      }

      /* Scene Palettes (No fire, no star) */
      .scene-cyber .scene-bg {
        background: radial-gradient(circle at 50% 30%, rgba(255, 42, 133, 0.28), transparent 45%), linear-gradient(180deg, #1b0c2b 0%, #0d091e 50%, #06050e 100%);
      }

      .scene-azure .scene-bg {
        background: radial-gradient(circle at 50% 25%, rgba(0, 240, 255, 0.35), transparent 45%), linear-gradient(180deg, #091e38 0%, #081122 55%, #050711 100%);
      }

      .scene-sunset .scene-bg {
        background: radial-gradient(circle at 50% 35%, rgba(200, 100, 160, 0.3), transparent 40%), linear-gradient(180deg, #30142b 0%, #1c0d1d 50%, #0e0611 100%);
      }

      .scene-naruto .scene-bg {
        background: radial-gradient(circle at 50% 30%, rgba(0, 240, 255, 0.25), transparent 45%), linear-gradient(180deg, #151d38 0%, #0f1325 55%, #070914 100%);
      }

      .scene-jjk .scene-bg {
        background: radial-gradient(circle at 50% 28%, rgba(168, 85, 247, 0.38), transparent 40%), linear-gradient(180deg, #240e3f 0%, #110920 50%, #06040a 100%);
      }

      /* Mountain Silhouettes */
      .mountain-back, .mountain-front {
        position: absolute;
        left: -10%;
        right: -10%;
        height: 38%;
        pointer-events: none;
      }

      .mountain-back {
        bottom: 18%;
        clip-path: polygon(0 80%, 15% 48%, 28% 62%, 45% 22%, 62% 60%, 78% 30%, 92% 55%, 100% 72%, 100% 100%, 0 100%);
        background: linear-gradient(180deg, rgba(30, 20, 50, 0.6) 0%, rgba(12, 10, 22, 0.95) 90%);
        opacity: 0.6;
      }

      .mountain-front {
        bottom: 12%;
        clip-path: polygon(0 70%, 20% 38%, 35% 58%, 52% 16%, 68% 54%, 85% 26%, 100% 64%, 100% 100%, 0 100%);
        background: linear-gradient(180deg, rgba(20, 15, 36, 0.85) 0%, #07060f 85%);
      }

      .horizon-glow {
        position: absolute;
        bottom: 16%;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--pink), var(--cyan), transparent);
        box-shadow: 0 0 25px var(--pink);
        opacity: 0.6;
      }

      /* Character Presentation */
      .character-wrap {
        position: absolute;
        bottom: 19%;
        left: 50%;
        transform: translateX(-50%);
        width: 190px;
        height: 290px;
        z-index: 3;
        animation: charSway 4s ease-in-out infinite;
        filter: drop-shadow(0 15px 25px rgba(0, 0, 0, 0.8));
      }

      @keyframes charSway {
        0%, 100% { transform: translate(-50%, 0); }
        50% { transform: translate(-50%, -10px); }
      }

      .character-aura {
        position: absolute;
        inset: -20px;
        border-radius: 50%;
        pointer-events: none;
        z-index: -1;
        opacity: 0.65;
        filter: blur(28px);
        animation: auraPulse 3s ease-in-out infinite alternate;
      }

      .scene-cyber .character-aura { background: radial-gradient(circle, var(--pink) 0%, transparent 70%); }
      .scene-azure .character-aura { background: radial-gradient(circle, var(--cyan) 0%, transparent 70%); }
      .scene-sunset .character-aura { background: radial-gradient(circle, rgba(244, 114, 182, 0.5) 0%, transparent 70%); }
      .scene-naruto .character-aura { background: radial-gradient(circle, rgba(0, 240, 255, 0.45) 0%, rgba(37, 99, 235, 0.3) 50%, transparent 70%); }
      .scene-jjk .character-aura { background: radial-gradient(circle, #a855f7 0%, #3b82f6 45%, transparent 70%); }

      @keyframes auraPulse {
        0% { transform: scale(0.9); opacity: 0.45; }
        100% { transform: scale(1.15); opacity: 0.85; }
      }

      .energy-slash {
        position: absolute;
        top: 35%;
        left: -40%;
        width: 180%;
        height: 4px;
        background: linear-gradient(90deg, transparent 0%, var(--pink) 40%, #ffffff 50%, var(--cyan) 60%, transparent 100%);
        box-shadow: 0 0 16px var(--pink), 0 0 32px var(--cyan);
        transform: rotate(-25deg);
        opacity: 0;
        pointer-events: none;
        z-index: 4;
        animation: slashPass 5s cubic-bezier(0.1, 0.9, 0.2, 1) infinite;
      }

      .energy-slash.second {
        top: 55%;
        transform: rotate(20deg);
        animation-delay: 2.5s;
        background: linear-gradient(90deg, transparent 0%, var(--cyan) 40%, #ffffff 50%, var(--purple) 60%, transparent 100%);
      }

      @keyframes slashPass {
        0%, 15% { transform: translate(-100%, 0) rotate(-25deg); opacity: 0; }
        22% { opacity: 1; }
        35%, 100% { transform: translate(100%, 0) rotate(-25deg); opacity: 0; }
      }

      .cinematic-fx {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 5;
        background:
          radial-gradient(circle at 50% 50%, transparent 45%, rgba(0, 0, 0, 0.75) 100%),
          linear-gradient(180deg, rgba(0, 0, 0, 0.4) 0%, transparent 22%, transparent 68%, rgba(0, 0, 0, 0.92) 100%);
      }

      /* Reel Content Overlay */
      .reel-overlay {
        position: relative;
        z-index: 10;
        padding: 0 68px 76px 16px;
        pointer-events: auto;
      }

      .reel-author {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
      }

      .author-name {
        font-size: 15px;
        font-weight: 800;
        color: #fff;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
      }

      .reel-caption {
        font-size: 13px;
        font-weight: 500;
        line-height: 1.45;
        color: #f1f0fa;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.9);
        margin-bottom: 8px;
      }

      .reel-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }

      .tag-pill {
        font-size: 12px;
        font-weight: 700;
        color: var(--cyan);
        text-shadow: 0 0 10px var(--cyan-glow);
      }

      /* Vertical Action Buttons Rail */
      .action-rail {
        position: absolute;
        right: 12px;
        bottom: 74px;
        z-index: 15;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
      }

      .creator-avatar-wrap {
        position: relative;
        margin-bottom: 4px;
      }

      .creator-pfp {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--pink), var(--purple));
        display: grid;
        place-items: center;
        font-size: 13px;
        font-weight: 800;
        border: 2px solid #fff;
      }

      .follow-plus {
        position: absolute;
        bottom: -6px;
        left: 50%;
        transform: translateX(-50%);
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: var(--pink);
        color: #fff;
        display: grid;
        place-items: center;
        font-size: 14px;
        font-weight: 900;
        border: 2px solid #000;
        cursor: pointer;
        transition: var(--trans);
      }

      .follow-plus.following {
        background: var(--cyan);
        transform: translateX(-50%) rotate(45deg);
      }

      .app-action-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3px;
        cursor: pointer;
      }

      .app-action-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(10px);
        display: grid;
        place-items: center;
        padding: 9px;
        color: #fff;
        transition: var(--trans);
      }

      .app-action-btn:hover .app-action-icon {
        transform: scale(1.15);
      }

      .app-action-btn.liked .app-action-icon {
        color: var(--pink);
        background: rgba(255, 42, 133, 0.2);
        animation: heartPop 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      }

      .app-action-btn.saved .app-action-icon {
        color: var(--cyan);
        background: rgba(0, 240, 255, 0.2);
      }

      .app-action-count {
        font-size: 11px;
        font-weight: 700;
        color: #fff;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.9);
      }

      /* TikTok Sound Marquee Bar in Reel Overlay */
      .tiktok-sound-bar {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 10px;
        cursor: pointer;
        max-width: 250px;
      }

      .sound-note-icon {
        width: 14px;
        height: 14px;
        color: #fff;
        flex-shrink: 0;
        filter: drop-shadow(0 0 6px var(--cyan-glow));
      }

      .sound-marquee-container {
        overflow: hidden;
        white-space: nowrap;
        mask-image: linear-gradient(90deg, #000 78%, transparent 100%);
        -webkit-mask-image: linear-gradient(90deg, #000 78%, transparent 100%);
      }

      .sound-marquee-track {
        display: inline-block;
        white-space: nowrap;
        font-size: 11.5px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.9);
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.9);
        animation: marqueeScroll 12s linear infinite;
      }

      @keyframes marqueeScroll {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }

      /* TikTok Spinning Vinyl Record Disc */
      .tiktok-vinyl-wrap {
        position: relative;
        margin-top: 6px;
        cursor: pointer;
      }

      .tiktok-vinyl-disc {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: radial-gradient(circle, #252427 15%, #050505 55%, #18171b 100%);
        border: 2px solid #141318;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.7);
        display: grid;
        place-items: center;
        position: relative;
        animation: vinylSpin 3.5s linear infinite;
      }

      .tiktok-vinyl-disc::before {
        content: "";
        position: absolute;
        inset: 4px;
        border-radius: 50%;
        border: 1px dashed rgba(255, 255, 255, 0.12);
        pointer-events: none;
      }

      .tiktok-vinyl-pfp {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--pink), var(--cyan));
        display: grid;
        place-items: center;
        font-size: 9px;
        font-weight: 900;
        color: #fff;
        border: 1px solid #fff;
      }

      @keyframes vinylSpin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }

      .tiktok-vinyl-wrap.paused .tiktok-vinyl-disc {
        animation-play-state: paused;
      }

      /* Floating Musical Notes */
      .note-particle {
        position: absolute;
        right: 14px;
        bottom: 26px;
        font-size: 14px;
        color: var(--cyan);
        pointer-events: none;
        opacity: 0;
        animation: floatNote 2.8s ease-out infinite;
      }

      .note-particle:nth-child(2) { animation-delay: 0.9s; right: 22px; font-size: 12px; color: var(--pink); }
      .note-particle:nth-child(3) { animation-delay: 1.8s; right: 8px; font-size: 15px; color: #fff; }

      @keyframes floatNote {
        0% { transform: translate(0, 0) scale(0.6); opacity: 0; }
        30% { opacity: 0.9; }
        100% { transform: translate(-26px, -52px) scale(1.1); opacity: 0; }
      }

      .tiktok-vinyl-wrap.paused .note-particle {
        display: none;
      }

      /* Anime Style Bottom Navigation Bar */
      .app-bottom-nav {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 68px;
        background: linear-gradient(180deg, rgba(14, 12, 24, 0.9), rgba(4, 4, 10, 0.98));
        border-top: 1px solid rgba(255, 42, 133, 0.28);
        box-shadow: 0 -8px 25px rgba(255, 42, 133, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(24px);
        display: flex;
        align-items: center;
        justify-content: space-around;
        padding-bottom: max(6px, env(safe-area-inset-bottom));
        z-index: 50;
      }

      .nav-tab-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1px;
        flex: 1;
        color: var(--muted);
        position: relative;
        cursor: pointer;
        transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), color 0.2s ease;
      }

      .nav-tab-btn:hover {
        transform: translateY(-2px);
        color: #fff;
      }

      .nav-icon-wrap {
        position: relative;
        width: 26px;
        height: 26px;
        display: grid;
        place-items: center;
        transition: var(--trans);
      }

      .nav-tab-btn .nav-icon-wrap svg {
        width: 24px;
        height: 24px;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.6));
        transition: var(--trans);
      }

      .nav-tab-btn .nav-title {
        font-family: var(--font-display);
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        line-height: 1.1;
      }

      .nav-tab-btn .nav-sub {
        font-size: 8px;
        font-weight: 700;
        color: var(--muted-dim);
        letter-spacing: 0.04em;
        line-height: 1;
        opacity: 0.85;
        transition: color 0.2s ease;
      }

      /* Active Anime Tab State */
      .nav-tab-btn.active {
        color: #fff;
      }

      .nav-tab-btn.active .nav-icon-wrap {
        transform: scale(1.12);
      }

      .nav-tab-btn.active .nav-icon-wrap svg {
        color: var(--pink);
        filter: drop-shadow(0 0 10px var(--pink-glow));
      }

      .nav-tab-btn[data-app-tab="discover"].active .nav-icon-wrap svg {
        color: var(--cyan);
        filter: drop-shadow(0 0 10px var(--cyan-glow));
      }

      .nav-tab-btn[data-app-tab="inbox"].active .nav-icon-wrap svg {
        color: #c084fc;
        filter: drop-shadow(0 0 10px rgba(192, 132, 252, 0.5));
      }

      .nav-tab-btn[data-app-tab="profile"].active .nav-icon-wrap svg {
        color: #f43f5e;
        filter: drop-shadow(0 0 10px rgba(244, 63, 94, 0.5));
      }

      .nav-tab-btn.active .nav-title {
        color: #fff;
        text-shadow: 0 0 8px rgba(255, 255, 255, 0.4);
      }

      .nav-tab-btn.active .nav-sub {
        color: var(--pink);
      }

      .nav-tab-btn[data-app-tab="discover"].active .nav-sub {
        color: var(--cyan);
      }

      /* Anime Center Create Button */
      .create-btn-icon {
        width: 44px;
        height: 28px;
        border-radius: 9px;
        background: linear-gradient(135deg, #ffffff, #e2e8f0);
        color: #0b0a16;
        display: grid;
        place-items: center;
        position: relative;
        box-shadow:
          -3px 0 0 var(--cyan),
          3px 0 0 var(--pink),
          0 0 18px rgba(0, 240, 255, 0.35);
        transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      }

      .nav-tab-btn.create-tab:hover .create-btn-icon {
        transform: scale(1.14);
        box-shadow:
          -4px 0 0 var(--cyan),
          4px 0 0 var(--pink),
          0 0 24px var(--pink-glow);
      }

      /* Notification Badge */
      .nav-badge {
        position: absolute;
        top: -3px;
        right: -8px;
        min-width: 15px;
        height: 15px;
        border-radius: 9999px;
        background: linear-gradient(135deg, var(--pink), #e11d48);
        border: 2px solid #07070e;
        color: #fff;
        font-size: 8.5px;
        font-weight: 900;
        display: grid;
        place-items: center;
        padding: 0 3px;
        box-shadow: 0 0 8px var(--pink);
      }

      /* Video Progress Bar Line */
      .reel-progress {
        position: absolute;
        bottom: 64px;
        left: 0;
        right: 0;
        height: 3px;
        background: rgba(255, 255, 255, 0.15);
        z-index: 30;
      }

      .reel-progress-fill {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, var(--pink), var(--cyan));
      }

      /* Center Play / Pause Feedback */
      .play-state-hud {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) scale(0.5);
        width: 68px;
        height: 68px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(12px);
        display: grid;
        place-items: center;
        color: #fff;
        padding: 16px;
        opacity: 0;
        pointer-events: none;
        z-index: 35;
        transition: var(--spring), opacity 0.3s;
      }

      .play-state-hud.show {
        transform: translate(-50%, -50%) scale(1);
        opacity: 1;
      }

      /* Double Tap Heart Burst */
      .heart-burst {
        position: absolute;
        width: 90px;
        height: 90px;
        transform: translate(-50%, -50%) scale(0);
        pointer-events: none;
        z-index: 60;
        color: var(--pink);
        filter: drop-shadow(0 0 25px var(--pink));
        animation: heartExplode 0.7s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
      }

      @keyframes heartExplode {
        0% { transform: translate(-50%, -50%) scale(0) rotate(-15deg); opacity: 0; }
        40% { transform: translate(-50%, -50%) scale(1.3) rotate(5deg); opacity: 1; }
        70% { transform: translate(-50%, -50%) scale(1) rotate(0deg); opacity: 0.9; }
        100% { transform: translate(-50%, -70%) scale(1.4) rotate(10deg); opacity: 0; }
      }

      /* Native Bottom Sheet Drawer */
      .sheet-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(6px);
        z-index: 80;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
      }

      .sheet-backdrop.open {
        opacity: 1;
        pointer-events: auto;
      }

      .bottom-sheet {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        max-height: 75%;
        border-radius: 24px 24px 0 0;
        background: var(--sheet-bg);
        border-top: 1px solid var(--border-glass);
        box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.8);
        z-index: 85;
        transform: translateY(105%);
        transition: transform 0.35s cubic-bezier(0.2, 0.9, 0.2, 1);
        display: flex;
        flex-direction: column;
      }

      .bottom-sheet.open {
        transform: translateY(0);
      }

      .sheet-handle-bar {
        width: 40px;
        height: 5px;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.25);
        margin: 10px auto 4px;
        cursor: grab;
      }

      .sheet-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 18px;
        border-bottom: 1px solid var(--border-glass);
      }

      .sheet-header h3 {
        font-size: 15px;
        font-weight: 800;
      }

      .sheet-close-btn {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        color: var(--muted);
      }

      .sheet-body {
        padding: 16px 18px 24px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      /* Sheet Internal Components */
      .sheet-comment-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-height: 260px;
        overflow-y: auto;
      }

      .sheet-comment-item {
        display: flex;
        gap: 10px;
        font-size: 12px;
      }

      .sheet-comment-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--cyan), var(--purple));
        display: grid;
        place-items: center;
        font-weight: 800;
        font-size: 10px;
        flex-shrink: 0;
      }

      .sheet-comment-content strong {
        display: block;
        color: #fff;
        margin-bottom: 2px;
      }

      .sheet-comment-content p {
        color: #d1d0e0;
        line-height: 1.4;
      }

      .sheet-input-box {
        display: flex;
        gap: 8px;
        margin-top: 6px;
      }

      .sheet-input {
        flex: 1;
        padding: 10px 14px;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid var(--border-glass);
        color: #fff;
        font: inherit;
        font-size: 13px;
        outline: none;
      }

      .sheet-input:focus {
        border-color: var(--pink);
      }

      .sheet-send-btn {
        padding: 10px 16px;
        border-radius: 9999px;
        background: var(--pink);
        color: #fff;
        font-size: 12px;
        font-weight: 800;
      }

      /* App Toast */
      .app-toast {
        position: absolute;
        top: 96px;
        left: 50%;
        transform: translate(-50%, -20px);
        opacity: 0;
        z-index: 95;
        padding: 8px 18px;
        border-radius: 9999px;
        background: rgba(18, 17, 32, 0.95);
        border: 1px solid var(--pink);
        box-shadow: 0 4px 20px var(--pink-glow);
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        pointer-events: none;
        transition: var(--trans);
      }

      .app-toast.show {
        transform: translate(-50%, 0);
        opacity: 1;
      }

      /* ==========================================
         FULL-SCREEN ANIME PROFILE PAGE (TikTok Style)
         ========================================== */
      .profile-page {
        position: absolute;
        inset: 0;
        z-index: 70;
        background: var(--app-bg);
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: none;
        transform: translateX(100%);
        transition: transform 0.35s cubic-bezier(0.2, 0.9, 0.2, 1);
      }
      .profile-page::-webkit-scrollbar { display: none; }
      .profile-page.open { transform: translateX(0); }

      /* Profile Banner */
      .profile-banner {
        position: relative;
        height: 160px;
        overflow: hidden;
      }
      .profile-banner-bg {
        position: absolute;
        inset: 0;
        background:
          radial-gradient(circle at 30% 60%, rgba(255, 42, 133, 0.5), transparent 50%),
          radial-gradient(circle at 70% 40%, rgba(0, 240, 255, 0.45), transparent 50%),
          radial-gradient(circle at 50% 80%, rgba(157, 78, 221, 0.35), transparent 50%),
          linear-gradient(180deg, #1a0e2e 0%, #0b0918 100%);
      }
      /* Anime sakura petals on banner */
      .banner-petal {
        position: absolute;
        width: 10px;
        height: 10px;
        background: rgba(255, 183, 197, 0.55);
        border-radius: 50% 0 50% 50%;
        pointer-events: none;
        animation: petalFall 6s ease-in-out infinite;
      }
      .banner-petal:nth-child(2) { left: 25%; animation-delay: 1.2s; width: 8px; height: 8px; }
      .banner-petal:nth-child(3) { left: 55%; animation-delay: 2.8s; width: 12px; height: 12px; }
      .banner-petal:nth-child(4) { left: 80%; animation-delay: 0.6s; width: 7px; height: 7px; }
      .banner-petal:nth-child(5) { left: 40%; animation-delay: 3.5s; }
      @keyframes petalFall {
        0% { transform: translate(0, -20px) rotate(0deg); opacity: 0; }
        20% { opacity: 0.7; }
        100% { transform: translate(30px, 180px) rotate(360deg); opacity: 0; }
      }

      /* Banner kanji watermark */
      .banner-kanji {
        position: absolute;
        bottom: 10px;
        right: 16px;
        font-size: 48px;
        font-weight: 900;
        color: rgba(255, 255, 255, 0.06);
        letter-spacing: 8px;
        pointer-events: none;
      }

      /* Profile back button */
      .profile-back-btn {
        position: absolute;
        top: 50px;
        left: 12px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(12px);
        border: 1px solid var(--border-glass);
        color: #fff;
        display: grid;
        place-items: center;
        cursor: pointer;
        z-index: 5;
        transition: var(--trans);
      }
      .profile-back-btn:hover { background: rgba(255, 255, 255, 0.15); }
      .profile-back-btn svg { width: 18px; height: 18px; }

      .profile-settings-btn {
        position: absolute;
        top: 50px;
        right: 12px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(12px);
        border: 1px solid var(--border-glass);
        color: #fff;
        display: grid;
        place-items: center;
        cursor: pointer;
        z-index: 5;
        transition: var(--trans);
      }
      .profile-settings-btn:hover { background: rgba(255, 255, 255, 0.15); }
      .profile-settings-btn svg { width: 18px; height: 18px; }

      /* Profile Info Section */
      .profile-info {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 0 20px 16px;
        margin-top: -44px;
        position: relative;
        z-index: 3;
      }

      .profile-avatar-ring {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        padding: 3px;
        background: linear-gradient(135deg, var(--pink), var(--cyan), var(--purple));
        animation: avatarGlow 4s ease-in-out infinite alternate;
        box-shadow: 0 0 30px var(--pink-glow), 0 0 60px rgba(0, 240, 255, 0.15);
      }
      @keyframes avatarGlow {
        0% { box-shadow: 0 0 25px var(--pink-glow); }
        100% { box-shadow: 0 0 35px var(--cyan-glow); }
      }
      .profile-avatar-inner {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: linear-gradient(135deg, #1a0e2e, #0b0918);
        display: grid;
        place-items: center;
        font-size: 30px;
        font-weight: 900;
        color: #fff;
        border: 3px solid #07070e;
        position: relative;
        overflow: hidden;
      }
      /* Mini anime eyes inside avatar */
      .avatar-anime-eyes {
        position: absolute;
        bottom: 18px;
        display: flex;
        gap: 12px;
      }
      .avatar-anime-eyes span {
        display: block;
        width: 10px;
        height: 14px;
        background: var(--cyan);
        border-radius: 50%;
        box-shadow: 0 0 8px var(--cyan-glow);
      }

      .profile-username {
        font-family: var(--font-display);
        font-size: 20px;
        font-weight: 900;
        color: #fff;
        margin-top: 10px;
      }
      .profile-handle {
        font-size: 13px;
        color: var(--muted);
        margin-top: 2px;
      }
      .profile-bio {
        font-size: 12.5px;
        color: #d1d0e0;
        text-align: center;
        line-height: 1.5;
        margin-top: 8px;
        max-width: 280px;
      }
      .profile-bio-link {
        color: var(--cyan);
        text-decoration: none;
        font-weight: 700;
      }

      /* Stats Row */
      .profile-stats {
        display: flex;
        justify-content: center;
        gap: 32px;
        padding: 16px 0;
      }
      .profile-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        cursor: pointer;
      }
      .profile-stat-number {
        font-family: var(--font-display);
        font-size: 18px;
        font-weight: 900;
        color: #fff;
      }
      .profile-stat-label {
        font-size: 11px;
        font-weight: 600;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }

      /* Action Buttons */
      .profile-actions {
        display: flex;
        justify-content: center;
        gap: 10px;
        padding: 0 20px 16px;
      }
      .profile-edit-btn {
        flex: 1;
        max-width: 160px;
        padding: 10px 0;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid var(--border-glass);
        color: #fff;
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
        transition: var(--trans);
      }
      .profile-edit-btn:hover { background: rgba(255, 255, 255, 0.14); }

      .profile-share-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid var(--border-glass);
        color: #fff;
        display: grid;
        place-items: center;
        cursor: pointer;
        transition: var(--trans);
      }
      .profile-share-btn:hover { background: rgba(255, 255, 255, 0.14); }
      .profile-share-btn svg { width: 16px; height: 16px; }

      /* Profile Content Tabs */
      .profile-tabs {
        display: flex;
        border-bottom: 1px solid var(--border-glass);
        position: sticky;
        top: 0;
        background: rgba(0, 0, 0, 0.92);
        backdrop-filter: blur(12px);
        z-index: 5;
      }
      .profile-tab {
        flex: 1;
        padding: 12px 0;
        text-align: center;
        font-size: 12px;
        font-weight: 800;
        color: var(--muted);
        cursor: pointer;
        position: relative;
        transition: var(--trans);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
      }
      .profile-tab:hover { color: #fff; }
      .profile-tab.active { color: #fff; }
      .profile-tab.active::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 32px;
        height: 3px;
        border-radius: 9999px;
        background: var(--pink);
        box-shadow: 0 0 10px var(--pink);
      }
      .profile-tab svg { width: 16px; height: 16px; }

      /* Video Grid */
      .profile-grid-panel {
        display: none;
        padding-bottom: 80px;
      }
      .profile-grid-panel.active { display: block; }

      .profile-video-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2px;
      }
      .profile-video-thumb {
        position: relative;
        aspect-ratio: 9/12;
        overflow: hidden;
        cursor: pointer;
        background: #0e0c1b;
      }
      .profile-video-thumb-bg {
        position: absolute;
        inset: 0;
        opacity: 0.85;
      }
      /* Unique gradient per thumb */
      .pv-cyber .profile-video-thumb-bg { background: radial-gradient(circle at 50% 40%, rgba(255,42,133,0.35), rgba(14,7,32,0.95)); }
      .pv-azure .profile-video-thumb-bg { background: radial-gradient(circle at 50% 40%, rgba(0,240,255,0.35), rgba(8,17,34,0.95)); }
      .pv-sunset .profile-video-thumb-bg { background: radial-gradient(circle at 50% 40%, rgba(200,100,160,0.3), rgba(14,6,17,0.95)); }
      .pv-naruto .profile-video-thumb-bg { background: radial-gradient(circle at 50% 40%, rgba(0,240,255,0.25), rgba(15,19,37,0.95)); }
      .pv-jjk .profile-video-thumb-bg { background: radial-gradient(circle at 50% 40%, rgba(168,85,247,0.38), rgba(6,4,10,0.95)); }
      .pv-lofi .profile-video-thumb-bg { background: radial-gradient(circle at 50% 40%, rgba(192,132,252,0.3), rgba(10,8,20,0.95)); }

      .profile-video-thumb:hover .profile-video-thumb-bg { opacity: 1; }
      .profile-video-thumb:hover { transform: scale(1.02); }

      /* Mini character inside thumb */
      .pv-char {
        position: absolute;
        bottom: 30%;
        left: 50%;
        transform: translateX(-50%);
        width: 40px;
        height: 60px;
      }
      .pv-char-head {
        width: 20px;
        height: 22px;
        border-radius: 50%;
        background: #fbd2c9;
        margin: 0 auto;
      }
      .pv-char-body {
        width: 28px;
        height: 30px;
        margin: -4px auto 0;
        border-radius: 4px 4px 0 0;
      }
      .pv-cyber .pv-char-body { background: linear-gradient(135deg, #19172e, #2d2850); }
      .pv-azure .pv-char-body { background: #0f172a; }
      .pv-sunset .pv-char-body { background: #2d132c; }
      .pv-naruto .pv-char-body { background: #2563eb; }
      .pv-jjk .pv-char-body { background: #090614; }
      .pv-lofi .pv-char-body { background: linear-gradient(135deg, #1e1b4b, #312e81); }

      /* Thumb view count overlay */
      .pv-views {
        position: absolute;
        bottom: 6px;
        left: 6px;
        display: flex;
        align-items: center;
        gap: 3px;
        font-size: 10px;
        font-weight: 700;
        color: #fff;
        text-shadow: 0 1px 4px rgba(0,0,0,0.9);
      }
      .pv-views svg { width: 12px; height: 12px; }

      /* Pinned badge */
      .pv-pinned {
        position: absolute;
        top: 6px;
        right: 6px;
        padding: 2px 6px;
        border-radius: 4px;
        background: var(--pink);
        font-size: 8px;
        font-weight: 900;
        color: #fff;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      /* Favorites list */
      .profile-favorites-list {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 14px;
      }
      .fav-anime-card {
        display: flex;
        gap: 12px;
        align-items: center;
        padding: 12px;
        border-radius: 14px;
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--border-glass);
        cursor: pointer;
        transition: var(--trans);
      }
      .fav-anime-card:hover { background: rgba(255,255,255,0.08); border-color: var(--pink); }

      .fav-anime-poster {
        width: 52px;
        height: 72px;
        border-radius: 8px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        font-size: 22px;
      }
      .fav-anime-info {
        flex: 1;
        min-width: 0;
      }
      .fav-anime-title {
        font-size: 13px;
        font-weight: 800;
        color: #fff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .fav-anime-meta {
        font-size: 11px;
        color: var(--muted);
        margin-top: 2px;
      }
      .fav-anime-rating {
        display: flex;
        align-items: center;
        gap: 4px;
        margin-top: 4px;
        font-size: 11px;
        font-weight: 700;
        color: var(--cyan);
      }

      /* Reposts tab */
      .profile-reposts-list {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .repost-card {
        display: flex;
        gap: 12px;
        padding: 12px;
        border-radius: 14px;
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--border-glass);
        cursor: pointer;
        transition: var(--trans);
      }
      .repost-card:hover { background: rgba(255,255,255,0.08); }
      .repost-thumb {
        width: 60px;
        height: 80px;
        border-radius: 8px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
      }
      .repost-info { flex: 1; min-width: 0; }
      .repost-creator {
        font-size: 12px;
        font-weight: 800;
        color: var(--pink);
      }
      .repost-desc {
        font-size: 11.5px;
        color: #d1d0e0;
        margin-top: 3px;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .repost-tag {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        margin-top: 5px;
        font-size: 10px;
        font-weight: 700;
        color: var(--muted);
        padding: 2px 8px;
        border-radius: 9999px;
        background: rgba(255,255,255,0.05);
      }

      /* Empty state */
      .profile-empty {
        padding: 40px 20px;
        text-align: center;
        color: var(--muted);
        font-size: 13px;
      }
      .profile-empty-icon {
        font-size: 36px;
        margin-bottom: 10px;
        opacity: 0.5;
      }
    </style>
  </head>
  <body>
    <!-- Desktop Mode Controls (Hidden when in standalone app mode) -->
    <div class="desktop-bar">
      <button class="desk-btn" id="toggle-frame-mode" type="button">📱 Phone Frame</button>
      <button class="desk-btn" id="install-app-btn" type="button">⬇️ Launch App</button>
    </div>

    <!-- Smartphone App Container -->
    <div class="device-container" id="device-app">
      <!-- Device Status Bar (Live Clock, Notch/Island, Signal, Battery) -->
      <div class="status-bar">
        <span class="status-time" id="status-clock">12:00</span>
        <div class="dynamic-island"></div>
        <div class="status-icons">
          <!-- Cellular Signal -->
          <svg class="status-icon-svg" viewBox="0 0 24 24" fill="currentColor">
            <rect x="2" y="16" width="3" height="5" rx="1"/>
            <rect x="7" y="12" width="3" height="9" rx="1"/>
            <rect x="12" y="8" width="3" height="13" rx="1"/>
            <rect x="17" y="4" width="3" height="17" rx="1"/>
          </svg>
          <!-- Battery -->
          <svg class="status-icon-svg" viewBox="0 0 24 24" fill="currentColor">
            <rect x="2" y="7" width="16" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="2"/>
            <rect x="4" y="9" width="11" height="6" rx="1"/>
            <path d="M20 10v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
      </div>

      <!-- App Header Bar -->
      <header class="app-header">
        <div class="app-header-title">anime<span>tock</span></div>
        <div class="app-tabs">
          <button class="app-tab" data-feed-tab="following" type="button">Following</button>
          <button class="app-tab active" data-feed-tab="foryou" type="button">For You</button>
        </div>
        <div class="header-right-actions">
          <button class="sound-pill muted" id="global-sound-toggle" type="button" aria-label="Toggle Sound" title="Sound Muted - Tap to Play">
            <div class="eq-bars">
              <span class="eq-bar"></span>
              <span class="eq-bar"></span>
              <span class="eq-bar"></span>
            </div>
            <span class="sound-label" id="sound-pill-status" style="font-size: 10px; font-weight: 800; text-transform: uppercase; margin-left: 2px;">Sound</span>
          </button>
          <button class="header-action-btn" id="header-search-btn" type="button" aria-label="Search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </button>
        </div>
      </header>

      <!-- TikTok Sound Start Hint Pill -->
      <button class="sound-hint-pill" id="sound-hint-pill" type="button">🎵 Tap to unmute anime lo-fi sound</button>

      <!-- Toast Alert -->
      <div class="app-toast" id="app-toast">Link copied!</div>

      <!-- Main Video Reels Feed (Drag & Swipe Native App Physics) -->
      <main class="app-feed" id="app-feed">
        <!-- REEL 1: Cyber Ronin -->
        <article class="app-reel" data-reel-id="1" data-genre="Action,Fantasy">
          <div class="scene scene-cyber" aria-hidden="true">
            <div class="scene-bg"></div>
            <div class="mountain-back"></div>
            <div class="mountain-front"></div>
            <div class="horizon-glow"></div>
            <canvas class="scene-particles"></canvas>
            <div class="energy-slash"></div>
            <div class="energy-slash second"></div>

            <div class="character-wrap">
              <div class="character-aura"></div>
              <svg viewBox="0 0 200 300">
                <defs>
                  <linearGradient id="cyberHair" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#ff2a85" />
                    <stop offset="50%" stop-color="#4a0e4e" />
                    <stop offset="100%" stop-color="#0e0720" />
                  </linearGradient>
                  <linearGradient id="cyberJacket" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#19172e" />
                    <stop offset="50%" stop-color="#2d2850" />
                    <stop offset="100%" stop-color="#0e0c1b" />
                  </linearGradient>
                  <filter id="neonGlow">
                    <feGaussianBlur stdDeviation="3" result="blur" />
                    <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
                  </filter>
                </defs>
                <line x1="45" y1="230" x2="165" y2="40" stroke="#00f0ff" stroke-width="4" filter="url(#neonGlow)" />
                <path d="M 50 160 L 100 130 L 150 160 L 175 295 L 25 295 Z" fill="url(#cyberJacket)" />
                <path d="M 85 145 L 100 295 L 115 145 Z" fill="#0b0a16" />
                <path d="M 55 170 L 95 295" stroke="#ff2a85" stroke-width="2" filter="url(#neonGlow)" />
                <path d="M 145 170 L 105 295" stroke="#00f0ff" stroke-width="2" filter="url(#neonGlow)" />
                <ellipse cx="100" cy="95" rx="30" ry="36" fill="#fbd2c9" />
                <path d="M 72 88 L 128 88 L 122 102 L 78 102 Z" fill="#00f0ff" filter="url(#neonGlow)" />
                <path d="M 55 90 C 50 40, 100 20, 140 45 C 160 60, 155 100, 145 110 C 135 100, 140 75, 120 60 C 105 50, 85 60, 75 80 C 65 95, 60 110, 55 90 Z" fill="url(#cyberHair)" />
              </svg>
            </div>
            <div class="cinematic-fx"></div>
          </div>

          <div class="play-state-hud" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </div>

          <div class="reel-overlay">
            <div class="reel-author">
              <span class="author-name">@koi.motion</span>
            </div>
            <p class="reel-caption">When the last neon light falls, the silent cyber hero awakens in Neo-Shibuya.</p>
            <div class="reel-tags">
              <span class="tag-pill">#CyberRonin</span>
              <span class="tag-pill">#AnimeEdit</span>
              <span class="tag-pill">#NeonVibes</span>
            </div>
            <div class="tiktok-sound-bar" data-sound-index="0" title="Tap sound to play/pause">
              <svg class="sound-note-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
              <div class="sound-marquee-container">
                <span class="sound-marquee-track">♫ Original Sound - @koi.motion · Cyber Ronin Synthwave Beat &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; ♫ Original Sound - @koi.motion · Cyber Ronin Synthwave Beat</span>
              </div>
            </div>
          </div>

          <div class="action-rail">
            <div class="creator-avatar-wrap">
              <div class="creator-pfp">KO</div>
              <button class="follow-plus" type="button" aria-label="Follow">+</button>
            </div>

            <button class="app-action-btn like-btn" type="button">
              <div class="app-action-icon">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
              </div>
              <span class="app-action-count">18.4K</span>
            </button>

            <button class="app-action-btn comment-btn" type="button">
              <div class="app-action-icon">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              </div>
              <span class="app-action-count">428</span>
            </button>

            <button class="app-action-btn save-btn" type="button">
              <div class="app-action-icon">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
              </div>
              <span class="app-action-count">2.1K</span>
            </button>

            <button class="app-action-btn share-btn" type="button">
              <div class="app-action-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
              </div>
              <span class="app-action-count">Share</span>
            </button>

            <div class="tiktok-vinyl-wrap paused" data-vinyl-index="0" title="Tap vinyl to toggle sound">
              <div class="tiktok-vinyl-disc">
                <div class="tiktok-vinyl-pfp">KO</div>
              </div>
              <span class="note-particle">♪</span>
              <span class="note-particle">♫</span>
              <span class="note-particle">♩</span>
            </div>
          </div>
        </article>

        <!-- REEL 2: Azure AMV -->
        <article class="app-reel" data-reel-id="2" data-genre="Action">
          <div class="scene scene-azure" aria-hidden="true">
