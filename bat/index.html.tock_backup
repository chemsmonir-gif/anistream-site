    <!-- Application Script -->
    <script>
      (function () {
        "use strict";

        // Global State
        let currentUser = "anime_fan";
        let currentReelIndex = 0;
        let activeCommentReelId = 1;

        // Elements
        const deviceApp = document.querySelector("#device-app");
        const toggleFrameBtn = document.querySelector("#toggle-frame-mode");
        const installAppBtn = document.querySelector("#install-app-btn");
        const appFeed = document.querySelector("#app-feed");
        const reels = Array.from(document.querySelectorAll(".app-reel"));
        const statusClock = document.querySelector("#status-clock");
        const progressFill = document.querySelector("#progress-fill");
        const appToast = document.querySelector("#app-toast");
        const sheetBackdrop = document.querySelector("#sheet-backdrop");

        // Comments Store
        const commentsDatabase = {
          1: [
            { author: "sora.neon", text: "The cyber rain and katana reflections look incredible!", time: "10m ago" },
            { author: "mika.edits", text: "Need an entire anime series with this cyber ronin character!", time: "1h ago" }
          ],
          2: [
            { author: "blade.dancer", text: "The lightning sync was absolute peak AMV!", time: "15m ago" },
            { author: "zenitsu.fan", text: "First form thunderclap vibes ⚡⚡", time: "2h ago" }
          ],
          3: [
            { author: "sakura.fall", text: "This feels like a brand new Shinkai anime movie.", time: "25m ago" },
            { author: "wanderer", text: "The sunset lighting and color palette are so comforting.", time: "4h ago" }
          ],
          4: [
            { author: "hokage.dreams", text: "Believe it! Naruto's Rasengan will always be legendary 🍥", time: "5m ago" },
            { author: "sasuke_uchiha", text: "Hmph. Not bad, dope.", time: "45m ago" }
          ],
          5: [
            { author: "gojo.simp", text: "THROUGHOUT HEAVEN AND EARTH HE ALONE IS THE HONORED ONE 🟣", time: "2m ago" },
            { author: "megumi.f", text: "The purple hollow technique is insane.", time: "18m ago" }
          ]
        };

        // ==========================================
        // TikTok Procedural Audio & Music Engine
        // ==========================================
        class TikTokAudioEngine {
          constructor() {
            this.ctx = null;
            this.isMuted = true;
            this.isPlaying = false;
            this.currentTrackIndex = 0;
            this.masterGain = null;
            this.musicGain = null;
            this.sfxGain = null;
            this.timerId = null;
            this.step = 0;

            // 5 Distinct Anime Soundtracks matching each reel
            this.tracks = [
              // Reel 1: Cyber Ronin (Synthwave Arpeggio)
              {
                bpm: 96,
                type: "sawtooth",
                cutoff: 1400,
                scale: [261.63, 311.13, 349.23, 392.00, 466.16, 523.25, 622.25],
                melody: [0, 2, 4, 3, 2, 0, 4, 5, 2, 1, 0, 3, 4, 2, 3, 5],
                bass: [130.81, 130.81, 155.56, 155.56, 174.61, 174.61, 116.54, 116.54]
              },
              // Reel 2: Azure AMV (Lightning Blade Electro)
              {
                bpm: 118,
                type: "square",
                cutoff: 2100,
                scale: [293.66, 349.23, 392.00, 440.00, 523.25, 587.33, 698.46],
                melody: [0, 4, 3, 5, 0, 3, 2, 4, 1, 3, 5, 4, 2, 0, 3, 5],
                bass: [146.83, 146.83, 174.61, 174.61, 196.00, 196.00, 130.81, 146.83]
              },
              // Reel 3: Sunset Journey (Lo-Fi Piano Chimes)
              {
                bpm: 82,
                type: "sine",
                cutoff: 1700,
                scale: [349.23, 392.00, 440.00, 523.25, 659.25, 698.46, 783.99],
                melody: [0, 2, 4, 3, 1, 3, 5, 4, 0, 2, 4, 6, 5, 4, 3, 2],
                bass: [174.61, 174.61, 220.00, 220.00, 130.81, 130.81, 164.81, 164.81]
              },
              // Reel 4: Naruto / Shinobi (Japanese Hirajoshi & Taiko)
              {
                bpm: 104,
                type: "triangle",
                cutoff: 1600,
                scale: [220.00, 233.08, 293.66, 329.63, 392.00, 440.00, 466.16],
                melody: [0, 1, 3, 4, 5, 3, 1, 0, 2, 3, 5, 4, 3, 1, 0, 3],
                bass: [110.00, 110.00, 146.83, 146.83, 164.81, 164.81, 110.00, 110.00]
              },
              // Reel 5: Jujutsu Kaisen (Hollow Purple Trap Synth)
              {
                bpm: 88,
                type: "sawtooth",
                cutoff: 980,
                scale: [155.56, 185.00, 207.65, 233.08, 277.18, 311.13, 370.00],
                melody: [0, 3, 2, 4, 0, 5, 4, 3, 1, 3, 4, 2, 0, 2, 4, 5],
                bass: [77.78, 77.78, 92.50, 92.50, 103.83, 103.83, 69.30, 77.78]
              }
            ];
          }

          initContext() {
            if (this.ctx) {
              if (this.ctx.state === "suspended") {
                this.ctx.resume();
              }
              return;
            }
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (!AudioCtx) return;
            this.ctx = new AudioCtx();

            this.masterGain = this.ctx.createGain();
            this.masterGain.gain.setValueAtTime(0.32, this.ctx.currentTime);
            this.masterGain.connect(this.ctx.destination);

            this.musicGain = this.ctx.createGain();
            this.musicGain.gain.setValueAtTime(this.isMuted ? 0 : 0.85, this.ctx.currentTime);
            this.musicGain.connect(this.masterGain);

            this.sfxGain = this.ctx.createGain();
            this.sfxGain.gain.setValueAtTime(1.0, this.ctx.currentTime);
            this.sfxGain.connect(this.masterGain);
          }

          unmute() {
            this.initContext();
            this.isMuted = false;
            this.isPlaying = true;
            if (this.musicGain && this.ctx) {
              this.musicGain.gain.setTargetAtTime(0.85, this.ctx.currentTime, 0.05);
            }
            this.startSequencer();
            this.syncUI();
          }

          mute() {
            this.isMuted = true;
            this.isPlaying = false;
            if (this.musicGain && this.ctx) {
              this.musicGain.gain.setTargetAtTime(0, this.ctx.currentTime, 0.05);
            }
            this.stopSequencer();
            this.syncUI();
          }

          toggleMute() {
            if (this.isMuted) {
              this.unmute();
              return true;
            } else {
              this.mute();
              return false;
            }
          }

          pause() {
            this.isPlaying = false;
            if (this.musicGain && this.ctx) {
              this.musicGain.gain.setTargetAtTime(0, this.ctx.currentTime, 0.05);
            }
            this.stopSequencer();
            this.syncUI();
          }

          resume() {
            if (this.isMuted) return;
            this.isPlaying = true;
            if (this.musicGain && this.ctx) {
              this.musicGain.gain.setTargetAtTime(0.85, this.ctx.currentTime, 0.05);
            }
            this.startSequencer();
            this.syncUI();
          }

          setTrack(index) {
            this.currentTrackIndex = Math.max(0, Math.min(this.tracks.length - 1, index));
            this.step = 0;
            if (!this.isMuted && this.isPlaying) {
              this.startSequencer();
            }
            this.syncUI();
          }

          startSequencer() {
            this.stopSequencer();
            if (!this.ctx || this.isMuted) return;

            const track = this.tracks[this.currentTrackIndex];
            const stepDurationMs = (60 / track.bpm / 2) * 1000;

            const tick = () => {
              if (this.isMuted || !this.isPlaying || !this.ctx) return;
              this.playStep(this.step, track);
              this.step = (this.step + 1) % 16;
              this.timerId = window.setTimeout(tick, stepDurationMs);
            };
            tick();
          }

          stopSequencer() {
            if (this.timerId) {
              window.clearTimeout(this.timerId);
              this.timerId = null;
            }
          }

          playStep(stepIndex, track) {
            if (!this.ctx || this.ctx.state === "suspended") return;
            const now = this.ctx.currentTime;

            // 1. Bass / Kick on downbeats
            if (stepIndex % 2 === 0) {
              const bassNote = track.bass[(stepIndex / 2) % track.bass.length];
              const bassOsc = this.ctx.createOscillator();
              const bassGain = this.ctx.createGain();
              const bassFilter = this.ctx.createBiquadFilter();

              bassOsc.type = "triangle";
              bassOsc.frequency.setValueAtTime(bassNote, now);

              if (stepIndex % 4 === 0) {
                bassOsc.frequency.setValueAtTime(bassNote * 1.5, now);
                bassOsc.frequency.exponentialRampToValueAtTime(bassNote, now + 0.04);
              }

              bassFilter.type = "lowpass";
              bassFilter.frequency.setValueAtTime(260, now);

              const bassDur = (60 / track.bpm) * 0.9;
              bassGain.gain.setValueAtTime(0.42, now);
              bassGain.gain.exponentialRampToValueAtTime(0.001, now + bassDur);

              bassOsc.connect(bassFilter);
              bassFilter.connect(bassGain);
              bassGain.connect(this.musicGain);

              bassOsc.start(now);
              bassOsc.stop(now + bassDur + 0.05);
            }

            // 2. High-hat / Lo-fi rhythm tick on off-beats
            if (stepIndex % 2 === 1) {
              const hatOsc = this.ctx.createOscillator();
              const hatGain = this.ctx.createGain();
              const hatFilter = this.ctx.createBiquadFilter();

              hatOsc.type = "square";
              hatOsc.frequency.setValueAtTime(4200, now);

              hatFilter.type = "highpass";
              hatFilter.frequency.setValueAtTime(5800, now);

              hatGain.gain.setValueAtTime(0.04, now);
              hatGain.gain.exponentialRampToValueAtTime(0.001, now + 0.03);

              hatOsc.connect(hatFilter);
              hatFilter.connect(hatGain);
              hatGain.connect(this.musicGain);

              hatOsc.start(now);
              hatOsc.stop(now + 0.04);
            }

            // 3. Lead Anime Lo-Fi Melody Synth Note
            const scaleIdx = track.melody[stepIndex % track.melody.length];
            const freq = track.scale[scaleIdx % track.scale.length];
            if (freq) {
              const osc = this.ctx.createOscillator();
              const gain = this.ctx.createGain();
              const filter = this.ctx.createBiquadFilter();

              osc.type = track.type;
              osc.frequency.setValueAtTime(freq, now);

              filter.type = "lowpass";
              filter.frequency.setValueAtTime(track.cutoff, now);
              filter.Q.setValueAtTime(2.2, now);

              const noteDur = (60 / track.bpm / 2) * 0.85;
              gain.gain.setValueAtTime(0.2, now);
              gain.gain.exponentialRampToValueAtTime(0.001, now + noteDur);

              osc.connect(filter);
              filter.connect(gain);
              gain.connect(this.musicGain);

              osc.start(now);
              osc.stop(now + noteDur + 0.05);
            }
          }

          // TikTok Signature Double-Tap Like SFX (Bubble Pop + Ascending Chime)
          playLikeSound() {
            this.initContext();
            if (!this.ctx) return;
            const now = this.ctx.currentTime;

            // 1. Pop bubble transient
            const popOsc = this.ctx.createOscillator();
            const popGain = this.ctx.createGain();
            popOsc.type = "sine";
            popOsc.frequency.setValueAtTime(650, now);
            popOsc.frequency.exponentialRampToValueAtTime(140, now + 0.045);

            popGain.gain.setValueAtTime(0.35, now);
            popGain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);

            popOsc.connect(popGain);
            popGain.connect(this.sfxGain);
            popOsc.start(now);
            popOsc.stop(now + 0.06);

            // 2. Rising two-tone sparkle chime
            [
              { freq: 880, delay: 0.035, dur: 0.22 }, // A5
              { freq: 1320, delay: 0.09, dur: 0.28 }  // E6
            ].forEach(({ freq, delay, dur }) => {
              const chimeOsc = this.ctx.createOscillator();
              const chimeGain = this.ctx.createGain();
              chimeOsc.type = "sine";
              chimeOsc.frequency.setValueAtTime(freq, now + delay);

              chimeGain.gain.setValueAtTime(0.001, now);
              chimeGain.gain.setValueAtTime(0.25, now + delay);
              chimeGain.gain.exponentialRampToValueAtTime(0.001, now + delay + dur);

              chimeOsc.connect(chimeGain);
              chimeGain.connect(this.sfxGain);
              chimeOsc.start(now + delay);
              chimeOsc.stop(now + delay + dur + 0.02);
            });
          }

          // Subtle TikTok UI Tap / Switch Click
          playClickSound() {
            this.initContext();
            if (!this.ctx) return;
            const now = this.ctx.currentTime;

            const clickOsc = this.ctx.createOscillator();
            const clickGain = this.ctx.createGain();
            const clickFilter = this.ctx.createBiquadFilter();

            clickOsc.type = "square";
            clickOsc.frequency.setValueAtTime(1200, now);

            clickFilter.type = "bandpass";
            clickFilter.frequency.setValueAtTime(1200, now);
            clickFilter.Q.setValueAtTime(3, now);

            clickGain.gain.setValueAtTime(0.09, now);
            clickGain.gain.exponentialRampToValueAtTime(0.001, now + 0.015);

            clickOsc.connect(clickFilter);
            clickFilter.connect(clickGain);
            clickGain.connect(this.sfxGain);

            clickOsc.start(now);
            clickOsc.stop(now + 0.02);
          }

          syncUI() {
            const isMutedOrPaused = this.isMuted || !this.isPlaying;
            const soundPill = document.querySelector("#global-sound-toggle");
            const soundLabel = document.querySelector("#sound-pill-status");
            const hintPill = document.querySelector("#sound-hint-pill");

            if (soundPill) {
              soundPill.classList.toggle("muted", isMutedOrPaused);
              soundPill.title = isMutedOrPaused ? "Sound Muted - Tap to Play" : "Sound Playing - Tap to Mute";
            }
            if (soundLabel) {
              soundLabel.textContent = isMutedOrPaused ? "Muted" : "Sound";
            }
            if (!this.isMuted && hintPill) {
              hintPill.style.opacity = "0";
              hintPill.style.pointerEvents = "none";
            }

            // Sync spinning vinyl discs
            document.querySelectorAll(".tiktok-vinyl-wrap").forEach((v, idx) => {
              if (idx === this.currentTrackIndex && !isMutedOrPaused) {
                v.classList.remove("paused");
              } else {
                v.classList.add("paused");
              }
            });
          }
        }

        const audioEngine = new TikTokAudioEngine();

        // Prime audio on first user touch anywhere
        window.addEventListener("pointerdown", () => {
          audioEngine.initContext();
        }, { once: true });

        // Live Clock
        function updateClock() {
          const now = new Date();
          const hours = now.getHours();
          const minutes = String(now.getMinutes()).padStart(2, "0");
          if (statusClock) statusClock.textContent = `${hours}:${minutes}`;
        }
        setInterval(updateClock, 5000);
        updateClock();

        // Toast Helper
        function showToast(msg) {
          appToast.textContent = msg;
          appToast.classList.add("show");
          window.clearTimeout(appToast._t);
          appToast._t = window.setTimeout(() => appToast.classList.remove("show"), 2000);
        }

        // Toggle Desktop Frame Mode vs Fullscreen App Mode
        toggleFrameBtn.addEventListener("click", () => {
          const isFullscreen = document.body.classList.toggle("mode-fullscreen");
          toggleFrameBtn.textContent = isFullscreen ? "🖥️ Fullscreen View" : "📱 Phone Frame";
          showToast(isFullscreen ? "Expanded View" : "Phone Frame View");
        });

        // Launch in Standalone App Window (using app.bat)
        installAppBtn.addEventListener("click", () => {
          showToast("Tip: Double-click app.bat to run as a dedicated desktop app!");
        });

        // Bottom Sheets System
        function openSheet(sheetId) {
          closeAllSheets();
          const sheet = document.getElementById(sheetId);
          if (sheet) {
            sheet.classList.add("open");
            sheetBackdrop.classList.add("open");
          }
        }

        function closeAllSheets() {
          document.querySelectorAll(".bottom-sheet").forEach((s) => s.classList.remove("open"));
          sheetBackdrop.classList.remove("open");
        }

        sheetBackdrop.addEventListener("click", closeAllSheets);
        document.querySelectorAll("[data-close-sheet]").forEach((btn) => {
          btn.addEventListener("click", closeAllSheets);
        });

        // Comments Sheet Render
        function showCommentsSheet(reelId) {
          activeCommentReelId = reelId;
          const container = document.querySelector("#sheet-comments-container");
          const comments = commentsDatabase[reelId] || [];
          container.innerHTML = comments
            .map(
              (c) => `
            <div class="sheet-comment-item">
              <div class="sheet-comment-avatar">${c.author.slice(0, 2).toUpperCase()}</div>
              <div class="sheet-comment-content">
                <strong>@${c.author} · ${c.time}</strong>
                <p>${c.text}</p>
              </div>
            </div>
          `
            )
            .join("");
          openSheet("comments-sheet");
        }

        // Post New Comment
        document.querySelector("#sheet-comment-form").addEventListener("submit", (e) => {
          e.preventDefault();
          const input = document.querySelector("#sheet-comment-input");
          const text = input.value.trim();
          if (!text) return;
          commentsDatabase[activeCommentReelId] = commentsDatabase[activeCommentReelId] || [];
          commentsDatabase[activeCommentReelId].unshift({
            author: currentUser,
            text,
            time: "Just now"
          });
          input.value = "";
          showCommentsSheet(activeCommentReelId);
          showToast("Comment posted!");
        });

        // Double-Tap Heart Burst
        function spawnHeartBurst(x, y, reel) {
          const heart = document.createElement("div");
          heart.className = "heart-burst";
          heart.style.left = `${x}px`;
          heart.style.top = `${y}px`;
          heart.innerHTML = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`;
          reel.appendChild(heart);
          window.setTimeout(() => heart.remove(), 800);
        }

        // Setup Reels & Action Rail
        reels.forEach((reel, idx) => {
          let lastTap = 0;
          const playHud = reel.querySelector(".play-state-hud");
          const likeBtn = reel.querySelector(".like-btn");
          const commentBtn = reel.querySelector(".comment-btn");
          const saveBtn = reel.querySelector(".save-btn");
          const shareBtn = reel.querySelector(".share-btn");
          const followBtn = reel.querySelector(".follow-plus");
          const vinylWrap = reel.querySelector(".tiktok-vinyl-wrap");
          const soundBar = reel.querySelector(".tiktok-sound-bar");

          // Tap to Play/Pause & Double-Tap to Like
          reel.addEventListener("click", (e) => {
            if (e.target.closest("button") || e.target.closest(".bottom-sheet") || e.target.closest(".tiktok-vinyl-wrap") || e.target.closest(".tiktok-sound-bar")) return;

            const now = Date.now();
            const rect = reel.getBoundingClientRect();
            const clickX = e.clientX - rect.left;
            const clickY = e.clientY - rect.top;

            if (now - lastTap < 320) {
              spawnHeartBurst(clickX, clickY, reel);
              likeBtn.classList.add("liked");
              audioEngine.playLikeSound();
              showToast("Liked! ❤️");
            } else {
              const isPaused = reel.classList.toggle("paused");
              if (isPaused) {
                audioEngine.pause();
              } else {
                audioEngine.resume();
              }
              playHud.innerHTML = isPaused
                ? `<svg viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>`
                : `<svg viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>`;
              playHud.classList.add("show");
              window.setTimeout(() => playHud.classList.remove("show"), 500);
            }
            lastTap = now;
          });

          likeBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            const liked = likeBtn.classList.toggle("liked");
            if (liked) audioEngine.playLikeSound();
            showToast(liked ? "Liked! ❤️" : "Unliked");
          });

          if (vinylWrap) {
            vinylWrap.addEventListener("click", (e) => {
              e.stopPropagation();
              const isPlaying = audioEngine.toggleMute();
              showToast(isPlaying ? "Sound Playing 🎵" : "Sound Muted 🔇");
            });
          }

          if (soundBar) {
            soundBar.addEventListener("click", (e) => {
              e.stopPropagation();
              const isPlaying = audioEngine.toggleMute();
              showToast(isPlaying ? "Sound Playing 🎵" : "Sound Muted 🔇");
            });
          }

          commentBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            audioEngine.playClickSound();
            showCommentsSheet(reel.dataset.reelId);
          });

          saveBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            audioEngine.playClickSound();
            const saved = saveBtn.classList.toggle("saved");
            showToast(saved ? "Saved to collection! 📌" : "Removed from collection");
          });

          shareBtn.addEventListener("click", async (e) => {
            e.stopPropagation();
            audioEngine.playClickSound();
            try {
              await navigator.clipboard.writeText(window.location.href);
              showToast("Link copied to clipboard!");
            } catch (err) {
              showToast("Share: " + window.location.href);
            }
          });

          followBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            audioEngine.playClickSound();
            const following = followBtn.classList.toggle("following");
            followBtn.textContent = following ? "✓" : "+";
            showToast(following ? "Creator followed!" : "Unfollowed");
          });
        });

        // Global Sound Controls
        const globalSoundToggle = document.querySelector("#global-sound-toggle");
        if (globalSoundToggle) {
          globalSoundToggle.addEventListener("click", (e) => {
            e.stopPropagation();
            const isPlaying = audioEngine.toggleMute();
            showToast(isPlaying ? "Sound Playing 🎵" : "Sound Muted 🔇");
          });
        }

        const soundHintPill = document.querySelector("#sound-hint-pill");
        if (soundHintPill) {
          soundHintPill.addEventListener("click", (e) => {
            e.stopPropagation();
            audioEngine.unmute();
            showToast("Anime Lo-Fi Sound Playing 🎵");
          });
        }

        // Feed Tabs (Following / For You)
        document.querySelectorAll(".app-tab").forEach((tab) => {
          tab.addEventListener("click", () => {
            document.querySelectorAll(".app-tab").forEach((t) => t.classList.remove("active"));
            tab.classList.add("active");
            audioEngine.playClickSound();
            showToast(`Feed: ${tab.textContent}`);
          });
        });

        // Drag & Touch Swipe Gesture Engine (Native App Feeling)
        let dragStartY = 0;
        let isDragging = false;

        appFeed.addEventListener("mousedown", (e) => {
          if (e.target.closest("button") || e.target.closest(".bottom-sheet")) return;
          isDragging = true;
          dragStartY = e.clientY;
        });

        window.addEventListener("mouseup", (e) => {
          if (!isDragging) return;
          isDragging = false;
          const diff = e.clientY - dragStartY;
          if (diff < -60) {
            goToReel(currentReelIndex + 1);
          } else if (diff > 60) {
            goToReel(currentReelIndex - 1);
          }
        });

        appFeed.addEventListener("touchstart", (e) => {
          dragStartY = e.touches[0].clientY;
        }, { passive: true });

        appFeed.addEventListener("touchend", (e) => {
          const diff = e.changedTouches[0].clientY - dragStartY;
          if (diff < -50) {
            goToReel(currentReelIndex + 1);
          } else if (diff > 50) {
            goToReel(currentReelIndex - 1);
          }
        }, { passive: true });

        function goToReel(idx) {
          const validIdx = Math.max(0, Math.min(reels.length - 1, idx));
          if (validIdx !== currentReelIndex) {
            currentReelIndex = validIdx;
            reels[currentReelIndex].scrollIntoView({ behavior: "smooth" });
            audioEngine.playClickSound();
            audioEngine.setTrack(currentReelIndex);
          }
        }

        // Keyboard Navigation
        window.addEventListener("keydown", (e) => {
          if (["input", "textarea"].includes(document.activeElement?.tagName?.toLowerCase())) return;
          if (e.key === "ArrowDown" || e.key === "j") goToReel(currentReelIndex + 1);
          if (e.key === "ArrowUp" || e.key === "k") goToReel(currentReelIndex - 1);
          if (e.key === " ") reels[currentReelIndex].click();
          if (e.key === "Escape") closeAllSheets();
        });

        // Progress Bar Simulation
        let progress = 0;
        setInterval(() => {
          progress = (progress + 0.8) % 100;
          if (progressFill) progressFill.style.width = `${progress}%`;
        }, 100);

        // Header Search Button
        document.querySelector("#header-search-btn").addEventListener("click", () => {
          audioEngine.playClickSound();
          openSheet("discover-sheet");
        });

        // Bottom Navigation Tabs
        document.querySelectorAll("[data-app-tab]").forEach((btn) => {
          btn.addEventListener("click", () => {
            audioEngine.playClickSound();
            const tab = btn.dataset.appTab;
            document.querySelectorAll(".nav-tab-btn").forEach((b) => b.classList.remove("active"));

            if (tab === "home") {
              btn.classList.add("active");
              closeAllSheets();
              goToReel(0);
            } else if (tab === "discover") {
              openSheet("discover-sheet");
            } else if (tab === "create") {
              openSheet("create-sheet");
            } else if (tab === "inbox") {
              openSheet("inbox-sheet");
            } else if (tab === "profile") {
              openSheet("profile-sheet");
            }
          });
        });

        // Category Filter in Discover Sheet
        document.querySelectorAll("[data-filter]").forEach((chip) => {
          chip.addEventListener("click", () => {
            audioEngine.playClickSound();
            const tag = chip.dataset.filter;
            reels.forEach((r) => {
              const genre = (r.dataset.genre || "").toLowerCase();
              r.hidden = tag !== "all" && !genre.includes(tag.toLowerCase());
            });
            const first = reels.find((r) => !r.hidden);
            if (first) first.scrollIntoView({ behavior: "smooth" });
            closeAllSheets();
            showToast(`Filtered: ${tag}`);
          });
        });

        // Search Input in Discover Sheet
        document.querySelector("#app-search-input").addEventListener("input", (e) => {
          const q = e.target.value.toLowerCase().trim();
          reels.forEach((r) => {
            r.hidden = q !== "" && !r.textContent.toLowerCase().includes(q);
          });
          const first = reels.find((r) => !r.hidden);
          if (first) first.scrollIntoView({ behavior: "smooth" });
        });

        // Canvas Particle Simulator
        class ParticleManager {
          constructor() {
            this.canvases = [];
            this.init();
          }

          init() {
            reels.forEach((reel, idx) => {
              const canvas = reel.querySelector(".scene-particles");
              if (!canvas) return;
              const ctx = canvas.getContext("2d");
              const particles = [];
              const type = idx + 1;

              const resize = () => {
                const rect = canvas.getBoundingClientRect();
                canvas.width = rect.width;
                canvas.height = rect.height;
              };
              resize();
              window.addEventListener("resize", resize);

              const count = type === 1 ? 35 : (type === 3 ? 30 : 25);
              for (let i = 0; i < count; i++) {
                particles.push({
                  x: Math.random() * canvas.width,
                  y: Math.random() * canvas.height,
                  size: Math.random() * 3 + 1,
                  speedX: (Math.random() - 0.5) * 1.5,
                  speedY: type === 1 ? Math.random() * 3.5 + 2 : (type === 3 ? Math.random() * 1.5 + 0.8 : (Math.random() - 0.5) * 2),
                  rot: Math.random() * 360,
                  opacity: Math.random() * 0.7 + 0.2
                });
              }

              this.canvases.push({ canvas, ctx, particles, type, reel });
            });

            this.animate();
          }

          animate() {
            this.canvases.forEach(({ canvas, ctx, particles, type, reel }) => {
              if (reel.hidden) return;
              ctx.clearRect(0, 0, canvas.width, canvas.height);

              particles.forEach((p) => {
                p.x += p.speedX;
                p.y += p.speedY;

                if (p.y > canvas.height) p.y = -10;
                if (p.y < -10) p.y = canvas.height;
                if (p.x > canvas.width) p.x = 0;
                if (p.x < 0) p.x = canvas.width;

                ctx.save();
                ctx.translate(p.x, p.y);
                ctx.globalAlpha = p.opacity;

                if (type === 1) {
                  ctx.fillStyle = p.size > 2 ? "#ff2a85" : "#00f0ff";
                  ctx.fillRect(0, 0, p.size, p.size * 3.5);
                } else if (type === 2) {
                  ctx.strokeStyle = "#00f0ff";
                  ctx.lineWidth = 1.5;
                  ctx.beginPath();
                  ctx.moveTo(0, 0);
                  ctx.lineTo(p.size * 2, p.size * 3);
                  ctx.stroke();
                } else if (type === 3) {
                  ctx.fillStyle = "#f472b6";
                  ctx.beginPath();
                  ctx.ellipse(0, 0, p.size * 2, p.size * 1.2, 0, 0, Math.PI * 2);
                  ctx.fill();
                } else if (type === 4) {
                  ctx.fillStyle = "#22c55e";
                  ctx.beginPath();
                  ctx.ellipse(0, 0, p.size * 2, p.size * 1.1, 0, 0, Math.PI * 2);
                  ctx.fill();
                } else {
                  ctx.fillStyle = p.size > 2 ? "#c084fc" : "#38bdf8";
                  ctx.beginPath();
                  ctx.arc(0, 0, p.size * 1.5, 0, Math.PI * 2);
                  ctx.fill();
                }

                ctx.restore();
              });
            });

            requestAnimationFrame(() => this.animate());
          }
        }

        new ParticleManager();
      })();
    </script>
  </body>
</html>
